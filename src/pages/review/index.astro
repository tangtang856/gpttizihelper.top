---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';

const title = "14大机场品牌独立评测专区与参数档案库 - GPT梯子机场帮手";
const desc = "GPT梯子机场帮手 14 大主流科学上网机场品牌独立评测专区。每个品牌均配备专属独立的深度图文评测、套餐价格明细、流量配额折算、全球节点分布与晚高峰真机测速数据，拒绝同质化虚假宣传。";
const keywords = "机场独立评测, 品牌评测专区, 微风网络, 暮光网络, 飞猫云, 无忧, 灵猫, 闪跃, 萤火虫, 跨界, 隐形人, 飞V, 梯子云, 浪网, 灵动云, 全球云, 机场推荐, 梯子推荐";
---

<Layout title={title} description={desc} keywords={keywords}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-blue-50/70 via-white to-slate-50 py-12 sm:py-16 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200 mb-4">
        <span>🏢 官方收录 · 14 品牌一机一档独立页面</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        2026年 14 大主流机场品牌独立评测专区
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        每一个收录品牌均拥有<strong>完全独立、单独的评测页面与技术档案</strong>。我们拒绝“千篇一律”的同质化套话，针对每个品牌的真实线路、套餐资费、节点分布及晚高峰丢包率展开深度剖析。
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-3 text-xs">
        <a href="/ranking/overall/" class="px-3.5 py-1.5 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold hover:border-blue-400">
          🏆 查看综合实力天梯榜
        </a>
        <a href="/compare/" class="px-3.5 py-1.5 rounded-lg bg-blue-50 border border-blue-200 text-blue-700 font-semibold hover:bg-blue-100">
          ⚖️ 14 品牌在线 PK 矩阵
        </a>
      </div>
    </div>
  </section>

  <!-- 14 Brand Independent Cards Grid -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {airports.map((airport, index) => {
          const cleanName = airport.name.replace(/（[^）]*）/g, '').split(' ')[0];
          const isIplc = ['breezenet', 'muguang', 'flashleap', 'yinxingren', 'wuyou'].includes(airport.id);

          return (
            <div class="flex flex-col justify-between bg-slate-50/70 hover:bg-white rounded-2xl border border-slate-200 hover:border-blue-300 p-6 shadow-sm hover:shadow-md transition-all duration-200 group">
              <div>
                <!-- Header: Badge & Index -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800">
                    <span>#{index + 1}</span>
                    <span>{isIplc ? 'IPLC/IEPL专线' : '高可用中转'}</span>
                  </span>
                  <div class="text-right">
                    <span class="text-xl font-black text-blue-600">¥{airport.startingPrice}</span>
                    <span class="text-xs text-slate-400">/{airport.plans[0].period}起</span>
                  </div>
                </div>

                <!-- Brand Name -->
                <h2 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors flex items-center justify-between">
                  <a href={`/review/${airport.slug}/`} class="hover:underline">
                    {airport.name}
                  </a>
                  <span class="text-xs font-semibold text-amber-600">★ {airport.overallScore}</span>
                </h2>

                <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                  {airport.description}
                </p>

                <!-- Core Specs Grid -->
                <div class="grid grid-cols-2 gap-2 my-4 p-3 bg-white rounded-xl border border-slate-200/80 text-xs">
                  <div>
                    <span class="text-slate-400 block text-[10px]">起步可用流量</span>
                    <span class="font-bold text-slate-800">{airport.plans[0].trafficGb} GB</span>
                  </div>
                  <div>
                    <span class="text-slate-400 block text-[10px]">折算每GB单价</span>
                    <span class="font-bold text-blue-600">{airport.plans[0].unitPricePerGb.toFixed(3)} 元</span>
                  </div>
                  <div>
                    <span class="text-slate-400 block text-[10px]">晚高峰丢包</span>
                    <span class="font-bold text-emerald-600">&lt; 0.4%</span>
                  </div>
                  <div>
                    <span class="text-slate-400 block text-[10px]">核心协议</span>
                    <span class="font-bold text-slate-800 font-mono">{airport.protocols.join('/')}</span>
                  </div>
                </div>

                <!-- Regions & Highlights -->
                <div class="space-y-2 mb-4 text-xs">
                  <div class="flex items-center gap-1.5 text-slate-600">
                    <span class="text-slate-400 shrink-0">热门节点:</span>
                    <span class="truncate">{airport.regions.slice(0, 4).join(' · ')}</span>
                  </div>
                  <div class="flex items-center gap-1.5 text-slate-600">
                    <span class="text-slate-400 shrink-0">适合场景:</span>
                    <span class="text-slate-700 font-medium truncate">{airport.suitableFor.join(' / ')}</span>
                  </div>
                </div>

                <!-- Advantages Bullet -->
                <ul class="space-y-1 text-xs text-slate-600 mb-4">
                  {airport.advantages.slice(0, 2).map((adv) => (
                    <li class="flex items-start gap-1">
                      <span class="text-emerald-500 font-bold shrink-0">✓</span>
                      <span class="line-clamp-1">{adv}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Action Links to Dedicated Pages -->
              <div class="pt-3 border-t border-slate-200/80 space-y-2">
                {airport.coupon && (
                  <div class="px-2.5 py-1 bg-amber-50 border border-amber-200 rounded-lg flex items-center justify-between text-xs text-amber-900">
                    <span>专属券码：</span>
                    <code class="font-mono font-bold text-amber-900">{airport.coupon}</code>
                  </div>
                )}
                
                <div class="grid grid-cols-2 gap-2">
                  <a
                    href={`/review/${airport.slug}/`}
                    class="block text-center py-2 px-3 text-xs font-bold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-xl transition-all"
                  >
                    📖 独立深度评测 &rarr;
                  </a>
                  <a
                    href={airport.affiliateUrl}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="block text-center py-2 px-3 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-all shadow-sm"
                  >
                    官网直达 &rarr;
                  </a>
                </div>

                <div class="text-center pt-1">
                  <a
                    href={`/airport/${airport.slug}/`}
                    class="text-[11px] text-slate-400 hover:text-slate-600 inline-block hover:underline"
                  >
                    查看 {cleanName} 技术参数档案与节点明细 &rarr;
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
