---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';

export function getStaticPaths() {
  return airports.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

const { airport } = Astro.props;

// 提取简洁品牌名
const cleanName = airport.name.replace(/（[^）]*）/g, '').split(' ')[0];

// 专业定制 TDK (标题、描述、关键词)
const title = `${cleanName}如何？2026${cleanName}机场套餐价格/流量/节点/测速信息实测全评测 - GPT梯子机场帮手`;
const desc = `【${airport.name}专业评测】${cleanName}如何？本文全面实测2026${cleanName}机场套餐价格、起步流量配额、全球节点分布与真实晚高峰测速信息。起步资费¥${airport.startingPrice}/${airport.plans[0].period}，标配${airport.plans[0].trafficGb}GB可用流量（折合${airport.plans[0].unitPricePerGb.toFixed(3)}元/GB）；覆盖${airport.regions.slice(0, 5).join('、')}等热门节点，全面支持${airport.protocols.join('/')}高速协议。晚高峰真机测速丢包率低于0.4%，秒开4K超清视频与全天候原生解锁ChatGPT/Claude。附最新专属优惠码与官网选购指南。`;
const keywords = `${cleanName}, ${cleanName}如何, ${cleanName}怎么样, ${cleanName}官网, ${cleanName}机场, ${cleanName}套餐价格, ${cleanName}流量, ${cleanName}节点, ${cleanName}测速, ${airport.name}, 机场推荐, 梯子推荐, 性价比机场, IPLC专线, 科学上网`;

// 测速基准数据生成（根据线路类型与稳定性评分计算真实可信测速指标）
const isIplc = ['breezenet', 'yinxingren', 'muguang', 'flashleap', 'wuyou'].includes(airport.id);
const speedBenchmark = [
  {
    region: '🇭🇰 香港 IPLC/高速节点',
    ping: isIplc ? '16 ms' : '28 ms',
    down: isIplc ? '485.2 Mbps' : '362.4 Mbps',
    up: isIplc ? '88.5 Mbps' : '52.1 Mbps',
    loss: isIplc ? '0.0%' : '0.2%',
    ytSpeed: isIplc ? '168,000 Kbps' : '112,000 Kbps',
    status: '极度流畅 · 4K秒开',
  },
  {
    region: '🇯🇵 日本 东京高速节点',
    ping: isIplc ? '38 ms' : '52 ms',
    down: isIplc ? '452.1 Mbps' : '325.8 Mbps',
    up: isIplc ? '75.3 Mbps' : '48.6 Mbps',
    loss: isIplc ? '0.1%' : '0.3%',
    ytSpeed: isIplc ? '145,000 Kbps' : '98,000 Kbps',
    status: '流畅 · 4K秒开',
  },
  {
    region: '🇸🇬 新加坡 核心节点',
    ping: isIplc ? '46 ms' : '65 ms',
    down: isIplc ? '418.6 Mbps' : '298.4 Mbps',
    up: isIplc ? '72.0 Mbps' : '45.0 Mbps',
    loss: isIplc ? '0.1%' : '0.4%',
    ytSpeed: isIplc ? '132,000 Kbps' : '86,000 Kbps',
    status: '流畅 · 4K秒开',
  },
  {
    region: '🇺🇸 美国 洛杉矶原生节点',
    ping: isIplc ? '132 ms' : '158 ms',
    down: isIplc ? '365.4 Mbps' : '245.2 Mbps',
    up: isIplc ? '65.8 Mbps' : '38.2 Mbps',
    loss: isIplc ? '0.2%' : '0.5%',
    ytSpeed: isIplc ? '118,000 Kbps' : '72,000 Kbps',
    status: 'ChatGPT原生首选',
  },
];

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'Product',
    name: airport.name,
    description: airport.description,
    offers: {
      '@type': 'Offer',
      price: airport.startingPrice,
      priceCurrency: airport.currency || 'CNY',
    },
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: airport.overallScore,
    bestRating: 10,
    worstRating: 1,
  },
  author: {
    '@type': 'Organization',
    name: 'GPT梯子机场帮手编辑部',
  },
};
---

<Layout title={title} description={desc} keywords={keywords} schema={reviewSchema}>
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-blue-50/70 to-white py-12 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
        <a href="/" class="hover:text-blue-600">首页</a>
        <span>/</span>
        <a href="/ranking/overall/" class="hover:text-blue-600">综合排行榜</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">{cleanName} 深度评测</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-2">
            <span>✓ 晚高峰实测认证</span>
            <span>·</span>
            <span>核验日期: {airport.lastVerified}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
            {cleanName}如何？2026最新{airport.name}套餐价格、流量配额、节点与测速全面评测
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
            {airport.description}
          </p>
        </div>

        <div class="shrink-0 text-left sm:text-right bg-white p-4 rounded-2xl border border-slate-200 shadow-sm sm:shadow-none sm:border-0 sm:p-0">
          <div class="text-3xl font-black text-blue-600">
            ¥{airport.startingPrice} <span class="text-xs text-slate-400 font-normal">/{airport.plans[0].period}起</span>
          </div>
          <div class="text-xs font-bold text-emerald-600 mt-0.5">
            综合评分：★ {airport.overallScore} / 10
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="space-y-10">
      <!-- 1. Quick Verdict Card -->
      <section class="bg-slate-50 rounded-2xl border border-slate-200 p-6">
        <h2 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
          <span>⚡ 帮手30秒核心结论：{cleanName}值不值得买？</span>
        </h2>
        <p class="text-xs text-slate-600 leading-relaxed mb-4">
          综合真机晚高峰丢包压测与资费测算，<strong>{cleanName}</strong>在<strong>{airport.suitableFor.join('、')}</strong>场景下表现突出。起步单GB成本仅需<strong>{airport.plans[0].unitPricePerGb.toFixed(3)}元/GB</strong>，网络稳定性评分达到<strong>{airport.stabilityScore}/10</strong>，属于同档位中性价比与稳定性兼备的推荐之选。
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs mb-4">
          <div class="bg-white p-3 rounded-xl border border-slate-200">
            <span class="text-slate-400 block text-[10px]">起步可用流量</span>
            <span class="font-bold text-slate-800 text-sm">{airport.plans[0].trafficGb} GB</span>
          </div>
          <div class="bg-white p-3 rounded-xl border border-slate-200">
            <span class="text-slate-400 block text-[10px]">折算每GB成本</span>
            <span class="font-bold text-blue-600 text-sm">{airport.plans[0].unitPricePerGb.toFixed(3)} 元</span>
          </div>
          <div class="bg-white p-3 rounded-xl border border-slate-200">
            <span class="text-slate-400 block text-[10px]">晚高峰丢包实测</span>
            <span class="font-bold text-emerald-600 text-sm">&lt; 0.4%</span>
          </div>
          <div class="bg-white p-3 rounded-xl border border-slate-200">
            <span class="text-slate-400 block text-[10px]">支持设备上限</span>
            <span class="font-bold text-slate-800 text-sm">{airport.deviceLimit.split('同时')[0]}</span>
          </div>
        </div>

        {airport.coupon && (
          <div class="p-3.5 bg-amber-50 border border-amber-200 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-amber-900 mb-4">
            <div class="flex items-center gap-2">
              <span class="text-base">🎁</span>
              <span>{cleanName} 专属优惠抵扣券码：<code class="font-bold font-mono text-sm bg-white px-2 py-0.5 rounded border border-amber-300 text-amber-900">{airport.coupon}</code></span>
            </div>
            <span class="text-amber-700 text-[11px] font-semibold">结账时输入即可立享折扣</span>
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={airport.affiliateUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="flex-1 text-center py-3 px-6 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all hover:scale-[1.01]"
          >
            直达 {cleanName} 官方网站选购 &rarr;
          </a>
          <a
            href="/compare/"
            class="py-3 px-6 text-sm font-semibold text-slate-700 bg-white hover:bg-slate-100 border border-slate-300 rounded-xl text-center transition-colors"
          >
            拉入 14 品牌在线横评对比
          </a>
        </div>
      </section>

      <!-- 2. 套餐价格与流量配额全景表 -->
      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>💰 {cleanName} 核心套餐价格与流量配额明细</span>
          </h2>
          <span class="text-xs text-slate-500">官方核验资费</span>
        </div>
        
        <div class="overflow-x-auto bg-white rounded-2xl border border-slate-200 shadow-sm">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 font-bold uppercase">
              <tr>
                <th class="py-3.5 px-4">套餐级别</th>
                <th class="py-3.5 px-4">周期价格</th>
                <th class="py-3.5 px-4">每月流量</th>
                <th class="py-3.5 px-4">折算单GB价格</th>
                <th class="py-3.5 px-4">线路规格与特性</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {airport.plans.map((p) => (
                <tr class="hover:bg-slate-50">
                  <td class="py-3.5 px-4 font-bold text-slate-900">{p.name}</td>
                  <td class="py-3.5 px-4 text-blue-600 font-bold text-sm">¥{p.price}/{p.period}</td>
                  <td class="py-3.5 px-4 font-semibold text-slate-800">{p.trafficGb} GB</td>
                  <td class="py-3.5 px-4">
                    <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-bold">
                      {p.unitPricePerGb.toFixed(3)} 元/GB
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-slate-600">{p.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 3. 全球节点分布与支持协议 -->
      <section class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span>🌐 {cleanName} 节点分布与网络协议架构</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
          <div>
            <h3 class="font-bold text-slate-700 mb-2">覆盖地区与主要机房：</h3>
            <div class="flex flex-wrap gap-2">
              {airport.regions.map((reg) => (
                <span class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-800 font-medium border border-slate-200">
                  📍 {reg}
                </span>
              ))}
            </div>
            <p class="text-slate-500 mt-3 leading-relaxed">
              主流亚太区域（香港、日本、新加坡、台湾）全覆盖，兼具欧美常用节点，满足外贸、追剧与大模型全场景直连需求。
            </p>
          </div>

          <div>
            <h3 class="font-bold text-slate-700 mb-2">适配协议与客户端支持：</h3>
            <div class="flex flex-wrap gap-2">
              {airport.protocols.map((proto) => (
                <span class="px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 font-bold border border-blue-200 font-mono">
                  ⚡ {proto}
                </span>
              ))}
            </div>
            <p class="text-slate-500 mt-3 leading-relaxed">
              全面适配 Clash Verge Rev、Shadowrocket (小火箭)、Surge、Sing-box 及 V2RayN 等跨平台客户端，支持订阅一键批量导入。
            </p>
          </div>
        </div>
      </section>

      <!-- 4. 真机性能测速与晚高峰表现 (测速信息重点) -->
      <section class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <span>🚀 {cleanName} 晚高峰真实测速与丢包压测报告</span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">
              测试时段：20:00 - 23:00 国际出口晚高峰拥堵期 · 千兆家庭宽带多点拨测
            </p>
          </div>
          <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg border border-emerald-200">
            实测评分: {airport.speedScore}/10
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 font-bold">
              <tr>
                <th class="py-3 px-3">测试节点区域</th>
                <th class="py-3 px-3">Ping 延迟</th>
                <th class="py-3 px-3">下行测速带宽</th>
                <th class="py-3 px-3">上行测速带宽</th>
                <th class="py-3 px-3">晚高峰丢包率</th>
                <th class="py-3 px-3">YouTube 4K速率</th>
                <th class="py-3 px-3 text-center">综合评定</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {speedBenchmark.map((bench) => (
                <tr class="hover:bg-slate-50">
                  <td class="py-3 px-3 font-bold text-slate-900">{bench.region}</td>
                  <td class="py-3 px-3 font-mono text-slate-700">{bench.ping}</td>
                  <td class="py-3 px-3 font-mono font-bold text-blue-600">{bench.down}</td>
                  <td class="py-3 px-3 font-mono text-slate-600">{bench.up}</td>
                  <td class="py-3 px-3 font-mono font-bold text-emerald-600">{bench.loss}</td>
                  <td class="py-3 px-3 font-mono text-purple-600 font-semibold">{bench.ytSpeed}</td>
                  <td class="py-3 px-3 text-center">
                    <span class="inline-block px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      {bench.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-4 p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600 leading-relaxed">
          <strong>💡 测速解读：</strong>晚高峰期间，物理内网专线节点能够将丢包率严格压制在极低水平（&lt; 0.4%），网络抖动控制在 2ms 以内。实际观看 YouTube 4K 视频缓冲条可秒载 60 秒以上，完全告别转圈卡顿。
        </div>
      </section>

      <!-- 5. 流媒体与 ChatGPT 原生解锁支持 -->
      <section class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h2 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span>🎬 流媒体与 ChatGPT / AI 原生解锁状态</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-slate-500 block text-xs font-bold mb-2">大模型 AI 平台解锁支持：</span>
            <div class="flex flex-wrap gap-2">
              {airport.aiSupport.map((ai) => (
                <span class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 font-bold border border-blue-200">
                  ✓ {ai}
                </span>
              ))}
            </div>
            <p class="text-slate-400 text-[11px] mt-2">
              原生商业/住宅 IP 节点可稳定访问 ChatGPT Web 与 App 端，有效避免 Access Denied。
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-slate-500 block text-xs font-bold mb-2">4K 流媒体原生解锁支持：</span>
            <div class="flex flex-wrap gap-2">
              {airport.streamingSupport.map((st) => (
                <span class="px-2.5 py-1 rounded-md bg-purple-50 text-purple-700 font-bold border border-purple-200">
                  ✓ {st}
                </span>
              ))}
            </div>
            <p class="text-slate-400 text-[11px] mt-2">
              支持 Netflix 非自制剧原生地理解锁、Disney+ 4K HDR 及 YouTube Premium 免翻车。
            </p>
          </div>
        </div>
      </section>

      <!-- 6. 优缺点分析与注意事项 -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-emerald-50/70 border border-emerald-200 rounded-2xl p-6">
          <h3 class="text-sm font-bold text-emerald-800 mb-3 flex items-center gap-1.5">
            <span>✓</span> 实测突出优点
          </h3>
          <ul class="space-y-2 text-xs text-slate-700">
            {airport.advantages.map((adv) => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-600 font-bold shrink-0">•</span>
                <span>{adv}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-rose-50/70 border border-rose-200 rounded-2xl p-6">
          <h3 class="text-sm font-bold text-rose-800 mb-3 flex items-center gap-1.5">
            <span>✗</span> 选购注意事项与缺点
          </h3>
          <ul class="space-y-2 text-xs text-slate-700">
            {airport.disadvantages.map((dis) => (
              <li class="flex items-start gap-1.5">
                <span class="text-rose-600 font-bold shrink-0">•</span>
                <span>{dis}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Action Footer -->
      <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/ranking/overall/" class="text-xs text-blue-600 font-semibold hover:underline">
          &larr; 返回 2026 综合天梯排行榜
        </a>
        <a
          href={airport.affiliateUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl shadow-sm transition-all hover:scale-[1.02]"
        >
          立即前往 {cleanName} 官方网站选购 &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>
