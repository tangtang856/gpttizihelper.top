---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';

export function getStaticPaths() {
  const categories = [
    {
      category: 'budget',
      title: '2026高性价比平价机场推荐 - 月付¥4.9起白菜价梯子选购',
      h1: '2026白菜价平价机场推荐：学生党与高性价比科学上网首选',
      desc: '专为预算有限与学生党精选的高性价比平价机场推荐。拒绝高价智商税，月付¥4.9~¥8起，每GB单价低至0.04元，兼顾高速IEPL专线与充沛月度流量。',
      matchIds: ['breezenet', 'feiv', 'feimaoyun', 'firefly'],
      rationale: '在白菜价梯子选择中，最忌讳只看月租而忽略每GB真实单价与是否会突然断流。本专题精选的4款平价机场，均经过晚高峰压力测试，起步门槛亲民且月度流量充足。',
    },
    {
      category: 'premium',
      title: '2026高端IEPL/IPLC纯专线机场推荐 - 晚高峰零丢包企业级梯子',
      h1: '2026高端IEPL/IPLC专线机场推荐：追求极致低延迟与零丢包',
      desc: '精选2026年企业级纯IEPL/IPLC高速内网专线机场。不走公网直达海外核心机房，晚高峰丢包率低于0.4%，专为涉外办公、远程协作与对延迟极度敏感的用户打造。',
      matchIds: ['yinxingren', 'muguang', 'flashleap', 'kuajiecloud'],
      rationale: '高端专线梯子的核心价值在于“确定性”。无论外界公网如何波动、国际出口是否拥堵，走内网光纤隧道的IPLC专线都能保证全天候秒开4K与极低网络抖动。',
    },
    {
      category: 'beginner',
      title: '2026新手小白友好机场推荐 - 一键导入零门槛配置梯子指南',
      h1: '2026新手小白入门机场推荐：开箱即用与一键导入教程',
      desc: '专为科学上网新手量身定制的入门级机场推荐。提供一键导入Clash/小火箭配置、傻瓜式客户端指引及贴心售后支持，彻底告别繁琐的节点手动编辑。',
      matchIds: ['feimaoyun', 'breezenet', 'firefly', 'wuyou'],
      rationale: '新手最怕遇到购买后不知如何配置或客户端报错无法联网。本专题推荐的品牌均具备极度精简的一键导入订阅功能，并附带针对各大客户端的直观图文操作指引。',
    },
    {
      category: 'stable',
      title: '2026高稳定性防失联机场推荐 - 抗封锁高可用备用梯子节点',
      h1: '2026高稳定性机场推荐：防封锁抗封锁与多线冗余容灾',
      desc: '针对特殊敏感时期与网络风暴严选的高稳定性机场推荐。具备多入口智能负载均衡与专线热备冗余，杜绝单点机房故障，提供全天候可靠的海外直连。',
      matchIds: ['yinxingren', 'muguang', 'wuyou', 'laddercloud'],
      rationale: '稳定性来自于冗余架构。当主用节点出现波动时，高可用机场可在毫秒级自动切换至备用入口与备用出口机房，保障外贸通讯、跨国会议不间断。',
    },
    {
      category: 'ai',
      title: '2026大模型ChatGPT/Claude专用机场推荐 - 原生商业住宅IP防封号',
      h1: '2026大模型专线机场推荐：ChatGPT与Claude原生IP无感解锁',
      desc: '专为深度调用ChatGPT、Claude 3.5 Sonnet、Midjourney打造的专业节点方案。采用纯净原生商业及住宅IP，避免Access Denied与机器人二次验证。',
      matchIds: ['lingmao', 'breezenet', 'yinxingren', 'wavenet'],
      rationale: '大模型平台对数据中心机房IP极度敏感。本专题筛选出的品牌在全美及亚太地区部署了大量高纯净度原生IP池，并配置了针对AI域名的专属分流规则。',
    },
    {
      category: 'streaming',
      title: '2026 4K流媒体追剧机场推荐 - Netflix/Disney+/YouTube秒开梯子',
      h1: '2026 4K流媒体专用机场推荐：Netflix与YouTube HDR全解锁',
      desc: '客厅电视大屏与影音发烧友专属的4K流媒体追剧机场推荐。全节点支持原生解锁美区/港区/日区Netflix、Disney+、HBO Max与YouTube 4K HDR超清码率。',
      matchIds: ['feimaoyun', 'muguang', 'kuajiecloud', 'quanqiuyun'],
      rationale: '4K/8K超高清视频对持续下行带宽与突发吞吐量要求极高。精选品牌节点均具备千兆冗余出口与自研BBR拥塞控制算法，彻底消灭视频缓冲圆圈。',
    },
  ];

  return categories.map((cat) => ({
    params: { category: cat.category },
    props: { ...cat },
  }));
}

const { title, h1, desc, matchIds, rationale } = Astro.props;

// Filter airports matching this category
const matchedAirports = airports.filter((a) => matchIds.includes(a.id));
---

<Layout title={title} description={desc}>
  <div class="bg-gradient-to-b from-blue-50/60 to-white py-12 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-700 mb-2 inline-block">
          &larr; 返回首页
        </a>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
          {h1}
        </h1>
        <p class="mt-4 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
          {desc}
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Editorial Rationale -->
    <div class="p-5 rounded-2xl bg-blue-50/80 border border-blue-200 text-sm text-slate-700 mb-10 leading-relaxed">
      <div class="font-bold text-blue-900 mb-1 flex items-center gap-2">
        <span>💡 帮手编辑部选型思路：</span>
      </div>
      <p>{rationale}</p>
    </div>

    <!-- Curated List -->
    <div class="space-y-6">
      {matchedAirports.map((item, idx) => (
        <article class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:border-blue-400 transition-all flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-800 text-xs font-bold">
                {idx + 1}
              </span>
              <h2 class="text-xl font-bold text-slate-900">
                <a href={`/review/${item.slug}/`} class="hover:text-blue-600 transition-colors">
                  {item.name}
                </a>
              </h2>
              <span class="text-xs px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">
                ★ {item.overallScore}
              </span>
            </div>

            <p class="text-xs text-slate-500 mb-4 leading-relaxed">
              {item.description}
            </p>

            <div class="flex flex-wrap items-center gap-4 text-xs">
              <div class="bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200">
                <span class="text-slate-400">起步套餐：</span>
                <span class="font-bold text-slate-800">¥{item.startingPrice}/{item.plans[0].period}</span>
              </div>
              <div class="bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200">
                <span class="text-slate-400">可用流量：</span>
                <span class="font-bold text-blue-600">{item.plans[0].trafficGb} GB</span>
              </div>
              <div class="bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200">
                <span class="text-slate-400">折算单价：</span>
                <span class="font-bold text-emerald-600">{item.plans[0].unitPricePerGb.toFixed(3)} 元/GB</span>
              </div>
            </div>

            <div class="mt-3 flex flex-wrap gap-1.5 text-xs">
              {item.advantages.map((adv) => (
                <span class="inline-flex items-center gap-1 text-[11px] text-slate-600 bg-slate-100 px-2 py-0.5 rounded">
                  <span class="text-emerald-500 font-bold">✓</span> {adv}
                </span>
              ))}
            </div>
          </div>

          <div class="w-full md:w-auto shrink-0 flex flex-col gap-2.5">
            {item.coupon && (
              <div class="text-center text-xs p-1.5 bg-amber-50 text-amber-800 rounded border border-amber-200">
                优惠码: <code class="font-bold">{item.coupon}</code>
              </div>
            )}
            <a
              href={item.affiliateUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="w-full text-center px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-colors whitespace-nowrap"
            >
              直达官方购买 &rarr;
            </a>
            <a
              href={`/review/${item.slug}/`}
              class="w-full text-center px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors"
            >
              查看独立评测报告
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Navigation -->
    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4 text-xs">
      <span class="text-slate-500">查看其他专题选型：</span>
      <div class="flex flex-wrap gap-2">
        <a href="/recommend/budget/" class="px-3 py-1.5 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg">💰 白菜平价</a>
        <a href="/recommend/premium/" class="px-3 py-1.5 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg">🚀 高端专线</a>
        <a href="/recommend/ai/" class="px-3 py-1.5 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg">🤖 AI大模型</a>
        <a href="/recommend/streaming/" class="px-3 py-1.5 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg">🎬 4K追剧</a>
        <a href="/recommend/stable/" class="px-3 py-1.5 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg">⚡ 晚高峰抗封</a>
      </div>
    </div>
  </div>
</Layout>
