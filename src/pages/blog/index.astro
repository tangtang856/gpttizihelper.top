---
import Layout from '../../layouts/Layout.astro';
import { allArticles } from '../../data/allArticles';

const title = "科学上网技术博客与避坑实录 (100篇) - 机场评测与专线深度剖析";
const desc = "2026专业科学上网博客与深度测评专栏。覆盖IEPL/IPLC专线底层架构、原生商业IP解锁机制、晚高峰防卡顿优化与防跑路避坑指南。";
---

<Layout title={title} description={desc}>
  <div class="bg-gradient-to-b from-blue-50/70 to-white py-12 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 mb-3">
        <span>📚 深度知识库 · 100 篇原创深度文章</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
        科学上网技术视野与深度避坑博客
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        用扎实的技术细节撕碎行业套路，从网络协议底层对抗、国际出口光缆走向到每GB资费真实测算，助你构建低延迟、高抗封的科学上网环境
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((art, idx) => (
        <a
          href={`/blog/${art.slug}/`}
          class="flex flex-col justify-between p-5 bg-white rounded-2xl border border-slate-200 hover:border-emerald-500 hover:shadow-lg transition-all group block cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700">
                {art.categoryBadge}
              </span>
              <span class="text-xs text-slate-400 font-mono">#{(idx + 1).toString().padStart(3, '0')}</span>
            </div>
            <h2 class="text-base font-bold text-slate-900 group-hover:text-emerald-600 transition-colors line-clamp-2">
              {art.title}
            </h2>
            <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
              {art.desc}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 group-hover:text-emerald-600 transition-colors font-medium">
            <span>阅读深度分析</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
