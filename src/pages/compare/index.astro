---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';

const title = "2026机场梯子横向在线对比工具 - 14大品牌多维度横评";
const desc = "支持自由勾选 2~4 家主流机场进行横向深度对比。对比维度涵盖起步资费、折算单价、节点架构、设备限制、流媒体与ChatGPT解锁能力。";
---

<Layout title={title} description={desc}>
  <div class="bg-gradient-to-b from-blue-50/60 to-white py-12 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-700 mb-2 inline-block">
        &larr; 返回首页
      </a>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
        ⚖️ 2026年 14 大机场梯子多维度在线对比工具
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        自由勾选或切换候选品牌，实时对比价格、线路架构、每GB成本与解锁特性，拒绝商家宣传话术
      </p>

      <!-- Selector controls -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <label for="airport-select" class="text-xs font-bold text-slate-700">添加对比品牌：</label>
        <select id="airport-select" class="text-xs px-3 py-2 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">-- 选择加入对比 --</option>
          {airports.map((a) => (
            <option value={a.id}>{a.name} (¥{a.startingPrice}/{a.plans[0].period})</option>
          ))}
        </select>
        <button id="reset-btn" type="button" class="text-xs px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-lg transition-colors">
          重置默认
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto p-4 sm:p-6">
      <div id="compare-table-container">
        <!-- Rendered via Client JS for instant reactivity -->
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ allAirports: airports }}>
  let selectedIds = ['breezenet', 'yinxingren', 'feimaoyun'];

  const container = document.getElementById('compare-table-container');
  const select = document.getElementById('airport-select');
  const resetBtn = document.getElementById('reset-btn');

  function renderTable() {
    if (!container) return;
    const items = allAirports.filter(a => selectedIds.includes(a.id));

    if (items.length === 0) {
      container.innerHTML = `<div class="text-center py-12 text-slate-400 text-sm">请从上方下拉框选择至少 1 家品牌加入对比</div>`;
      return;
    }

    let html = `
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="py-4 px-4 w-36 font-bold text-slate-400 bg-slate-50">对比维度</th>
            ${items.map(item => `
              <th class="py-4 px-4 text-center border-l border-slate-100">
                <div class="font-extrabold text-sm text-slate-900 mb-1">${item.name}</div>
                <div class="text-[11px] text-blue-600 font-bold mb-2">¥${item.startingPrice}/${item.plans[0].period}</div>
                <button data-remove="${item.id}" class="text-[10px] text-rose-500 hover:underline">移除对比</button>
              </th>
            `).join('')}
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="py-3 px-4 font-bold text-slate-700 bg-slate-50">可用起步流量</td>
            ${items.map(item => `<td class="py-3 px-4 text-center font-bold text-slate-800 border-l border-slate-100">${item.plans[0].trafficGb} GB</td>`).join('')}
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-700 bg-slate-50">每GB折算成本</td>
            ${items.map(item => `<td class="py-3 px-4 text-center text-blue-600 font-bold border-l border-slate-100">${item.plans[0].unitPricePerGb.toFixed(3)} 元/GB</td>`).join('')}
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-700 bg-slate-50">线路与协议</td>
            ${items.map(item => `<td class="py-3 px-4 text-center text-slate-600 border-l border-slate-100">${item.protocols.join(', ')}</td>`).join('')}
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-700 bg-slate-50">设备连接上限</td>
            ${items.map(item => `<td class="py-3 px-4 text-center text-slate-600 border-l border-slate-100">${item.deviceLimit}</td>`).join('')}
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-700 bg-slate-50">ChatGPT与AI支持</td>
            ${items.map(item => `<td class="py-3 px-4 text-center text-emerald-600 font-semibold border-l border-slate-100">${item.aiSupport.join(', ')}</td>`).join('')}
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-700 bg-slate-50">流媒体原生解锁</td>
            ${items.map(item => `<td class="py-3 px-4 text-center text-slate-600 border-l border-slate-100">${item.streamingSupport.join(', ')}</td>`).join('')}
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-700 bg-slate-50">核心优点</td>
            ${items.map(item => `<td class="py-3 px-4 text-slate-600 border-l border-slate-100 text-left">${item.advantages.map(a => `<div>✓ ${a}</div>`).join('')}</td>`).join('')}
          </tr>
          <tr>
            <td class="py-4 px-4 font-bold text-slate-700 bg-slate-50">直达入口</td>
            ${items.map(item => `
              <td class="py-4 px-4 text-center border-l border-slate-100">
                <a href="${item.affiliateUrl}" target="_blank" rel="noopener noreferrer nofollow" class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-sm">
                  官网直达 &rarr;
                </a>
              </td>
            `).join('')}
          </tr>
        </tbody>
      </table>
    `;

    container.innerHTML = html;

    container.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-remove');
        selectedIds = selectedIds.filter(x => x !== id);
        renderTable();
      });
    });
  }

  if (select) {
    select.addEventListener('change', () => {
      const val = select.value;
      if (val && !selectedIds.includes(val)) {
        if (selectedIds.length >= 4) {
          alert('最多同时支持横向对比 4 家品牌！');
          select.value = '';
          return;
        }
        selectedIds.push(val);
        renderTable();
        select.value = '';
      }
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      selectedIds = ['breezenet', 'yinxingren', 'feimaoyun'];
      renderTable();
    });
  }

  renderTable();
</script>
