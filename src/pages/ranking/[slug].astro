---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';

export function getStaticPaths() {
  const rankings = [
    {
      slug: 'overall',
      title: '2026好用机场综合排行榜 - 14大梯子品牌实测天梯榜',
      h1: '2026年 14 大主流机场综合实力天梯排行榜',
      desc: '综合考量晚高峰丢包率、网络延迟、单GB成本、原生解锁能力与售后口碑的2026全景机场排行榜。',
      criteria: '综合评分 = 晚高峰网络稳定性(35%) + 真实性价比(25%) + 流媒体/AI解锁(25%) + 客户端易用性(15%)。数据定期真实复测。',
      sortFn: (a: any, b: any) => a.rank - b.rank,
    },
    {
      slug: 'value',
      title: '2026高性价比机场排行榜 - 每GB流量真实单价对比测算',
      h1: '2026性价比机场排行榜：每GB成本折算与超值套餐盘点',
      desc: '杜绝虚标价格套路！按照实际可用流量与折算单价计算的2026高性价比机场梯子排行。',
      criteria: '排序依据：每GB真实可用单价（元/GB）由低到高排列。剔除虚假虚标倍率，只计算真实有效可用流量。',
      sortFn: (a: any, b: any) => a.plans[0].unitPricePerGb - b.plans[0].unitPricePerGb,
    },
    {
      slug: 'budget',
      title: '2026平价低预算机场排行榜 - 月付¥4.9起白菜价梯子排名',
      h1: '2026低预算平价机场排行榜：学生党零负担科学上网精选',
      desc: '专为极低预算、临时备用与轻度出海冲浪精选的平价梯子排行榜，月付¥4.9~¥8起，拒绝大额年付绑架。',
      criteria: '排序依据：起步套餐月付资费从低到高排列。优先展示支持月付或不限时按量计费的良心品牌。',
      sortFn: (a: any, b: any) => a.startingPrice - b.startingPrice,
    },
    {
      slug: 'stable',
      title: '2026高稳定性机场排行榜 - IEPL/IPLC纯专线晚高峰抗封天梯',
      h1: '2026高稳定性机场排行榜：晚高峰极低丢包与专线抗封盘点',
      desc: '针对晚高峰8-11点核心时段，结合万次连续丢包压测与机房容灾调度能力评定的高稳定机场天梯。',
      criteria: '排序依据：晚高峰丢包率 < 0.4%、是否具备物理IPLC内网专线与主备双机房调度。',
      sortFn: (a: any, b: any) => b.stabilityScore - a.stabilityScore,
    },
  ];

  return rankings.map((r) => ({
    params: { slug: r.slug },
    props: { ...r },
  }));
}

const { title, h1, desc, criteria, sortFn, slug } = Astro.props;

// Sort airports based on ranking criteria
const sortedAirports = [...airports].sort(sortFn);
---

<Layout title={title} description={desc}>
  <div class="bg-gradient-to-b from-blue-50/60 to-white py-12 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-700 mb-2 inline-block">
        &larr; 返回首页
      </a>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
        {h1}
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        {desc}
      </p>

      <!-- Ranking Sub-tabs -->
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        <a
          href="/ranking/overall/"
          class={`px-4 py-1.5 rounded-full text-xs font-bold transition-all ${
            slug === 'overall' ? 'bg-blue-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
          }`}
        >
          🏆 综合天梯榜
        </a>
        <a
          href="/ranking/value/"
          class={`px-4 py-1.5 rounded-full text-xs font-bold transition-all ${
            slug === 'value' ? 'bg-blue-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
          }`}
        >
          💰 每GB性价比榜
        </a>
        <a
          href="/ranking/budget/"
          class={`px-4 py-1.5 rounded-full text-xs font-bold transition-all ${
            slug === 'budget' ? 'bg-blue-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
          }`}
        >
          🏷️ 最低门槛平价榜
        </a>
        <a
          href="/ranking/stable/"
          class={`px-4 py-1.5 rounded-full text-xs font-bold transition-all ${
            slug === 'stable' ? 'bg-blue-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
          }`}
        >
          ⚡ 晚高峰稳定性榜
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="p-4 bg-slate-100 rounded-xl border border-slate-200 text-xs text-slate-600 mb-8 flex items-center gap-2">
      <span class="font-bold text-slate-800">📊 榜单排名规则：</span>
      <span>{criteria}</span>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 border-b border-slate-200 text-xs text-slate-700 uppercase font-bold">
            <tr>
              <th scope="col" class="py-3.5 px-4 text-center w-16">榜位</th>
              <th scope="col" class="py-3.5 px-4">品牌名称</th>
              <th scope="col" class="py-3.5 px-4">起步资费</th>
              <th scope="col" class="py-3.5 px-4">每月流量</th>
              <th scope="col" class="py-3.5 px-4">折算单价</th>
              <th scope="col" class="py-3.5 px-4 hidden md:table-cell">核心线路特性</th>
              <th scope="col" class="py-3.5 px-4 hidden lg:table-cell">推荐受众</th>
              <th scope="col" class="py-3.5 px-4 text-center">评测与直达</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {sortedAirports.map((item, idx) => (
              <tr class="hover:bg-blue-50/40 transition-colors">
                <td class="py-3.5 px-4 text-center">
                  <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ${
                    idx === 0 ? 'bg-amber-100 text-amber-800 border border-amber-300' :
                    idx === 1 ? 'bg-slate-200 text-slate-800' :
                    idx === 2 ? 'bg-amber-50 text-amber-700' :
                    'bg-slate-100 text-slate-500'
                  }`}>
                    {idx + 1}
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <a href={`/review/${item.slug}/`} class="font-bold text-slate-900 hover:text-blue-600 block transition-colors">
                    {item.name}
                  </a>
                  <span class="text-[10px] text-slate-400 font-mono">
                    {item.protocols.join(' · ')}
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-bold text-blue-600 text-base">¥{item.startingPrice}</span>
                  <span class="text-[11px] text-slate-400">/{item.plans[0].period}</span>
                </td>
                <td class="py-3.5 px-4 font-semibold text-slate-800">
                  {item.plans[0].trafficGb} GB
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2 py-0.5 rounded text-xs font-bold bg-blue-50 text-blue-700">
                    {item.plans[0].unitPricePerGb.toFixed(3)} 元/GB
                  </span>
                </td>
                <td class="py-3.5 px-4 hidden md:table-cell text-xs text-slate-600">
                  {item.plans[0].note.split('，')[0]}
                </td>
                <td class="py-3.5 px-4 hidden lg:table-cell text-xs text-slate-500">
                  {item.suitableFor[0]}
                </td>
                <td class="py-3.5 px-4 text-center">
                  <div class="flex items-center justify-center gap-2">
                    <a
                      href={`/review/${item.slug}/`}
                      class="px-2.5 py-1 text-xs font-medium text-slate-600 hover:text-blue-600 bg-slate-100 rounded transition-colors"
                    >
                      评测
                    </a>
                    <a
                      href={item.affiliateUrl}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="px-3 py-1 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded transition-colors shadow-sm"
                    >
                      直达 &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
