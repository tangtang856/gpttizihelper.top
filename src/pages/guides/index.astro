---
import Layout from '../../layouts/Layout.astro';
import { allGuides } from '../../data/allGuides';

const title = "科学上网客户端全平台使用教程 (30篇) - Clash / 小火箭 / Surge 极速配置指南";
const desc = "2026全网最全科学上网全平台配置教程中心。覆盖 Windows、macOS、iOS、Android 及 Apple TV，包含 Clash Verge Rev、Shadowrocket 小火箭、Sing-box 等主流客户端一键导入与规则分流。";

// Group guides by platform
const platforms = [
  { id: 'all', name: '全部 30 篇教程' },
  { id: 'windows', name: '💻 Windows 端', match: 'Windows' },
  { id: 'macos', name: '🍎 macOS 苹果电脑', match: 'macOS' },
  { id: 'ios', name: '📱 iOS / iPhone', match: 'iOS' },
  { id: 'android', name: '🤖 Android 安卓端', match: 'Android' },
  { id: 'tv', name: '📺 电视与特殊终端', match: '电视' },
];
---

<Layout title={title} description={desc}>
  <div class="bg-gradient-to-b from-blue-50/70 to-white py-12 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 mb-3">
        <span>📖 小白救命中心 · 30 篇图文教程</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight">
        全平台科学上网客户端使用与配置指南
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        手把手带你从零下载、安装、一键导入机场订阅、开启系统代理并配置精准规则分流，彻底杜绝回国流量消耗与应用报错
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Grid of Guides -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allGuides.map((guide, idx) => (
        <a
          href={`/guides/${guide.slug}/`}
          class="flex flex-col justify-between p-5 bg-white rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all group"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-blue-50 text-blue-700">
                {guide.platformBadge}
              </span>
              <span class="text-xs text-slate-400 font-mono">#{(idx + 1).toString().padStart(2, '0')}</span>
            </div>
            <h2 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2">
              {guide.title}
            </h2>
            <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
              {guide.desc}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 group-hover:text-blue-600 transition-colors">
            <span>阅读完整配置步骤</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
