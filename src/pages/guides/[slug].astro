---
import Layout from '../../layouts/Layout.astro';
import { allGuides } from '../../data/allGuides';

export function getStaticPaths() {
  return allGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const title = `${guide.title} - GPT梯子机场帮手配置指南`;
const desc = guide.desc;
const keywords = `${guide.keywords}, 机场推荐, 梯子推荐, 科学上网教程`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.h1,
  description: guide.desc,
  author: {
    '@type': 'Organization',
    name: 'GPT梯子机场帮手编辑部',
  },
  publisher: {
    '@type': 'Organization',
    name: 'GPT梯子机场帮手',
  },
};
---

<Layout title={title} description={desc} keywords={keywords} schema={articleSchema}>
  <div class="bg-gradient-to-b from-blue-50/70 to-white py-12 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
        <a href="/" class="hover:text-blue-600">首页</a>
        <span>/</span>
        <a href="/guides/" class="hover:text-blue-600">客户端教程</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">{guide.platformBadge}</span>
      </div>

      <span class="inline-block text-xs font-bold px-2.5 py-1 rounded bg-blue-100 text-blue-800 mb-3">
        {guide.platformBadge}
      </span>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-snug">
        {guide.h1}
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
        {guide.desc}
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <article class="prose prose-slate max-w-none text-slate-700 leading-relaxed">
      <div set:html={guide.content} />
    </article>

    <!-- Bottom Actions & Navigation -->
    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <a href="/guides/" class="text-blue-600 font-semibold hover:underline">
        &larr; 返回全平台客户端教程列表
      </a>
      <div class="flex items-center gap-2">
        <a href="/ranking/overall/" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg font-semibold text-slate-700">
          🏆 查看2026综合天梯榜
        </a>
        <a href="/recommend/budget/" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-bold text-white shadow-sm">
          💰 查看平价白菜梯子推荐
        </a>
      </div>
    </div>
  </div>
</Layout>
