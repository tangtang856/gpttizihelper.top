---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';

const title = "14大机场品牌节点与技术参数档案总览 - GPT梯子机场帮手";
const desc = "GPT梯子机场帮手 14 大主流机场官方技术档案库。包含微风网络、暮光网络、飞猫云、无忧、灵猫、闪跃、萤火虫、跨界、隐形人、飞V、梯子云、浪网、灵动云、全球云的节点分布、线路架构、支持协议与套餐流量参数明细。";
---

<Layout title={title} description={desc}>
  <div class="bg-gradient-to-b from-blue-50/70 via-white to-slate-50 py-12 sm:py-16 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200 mb-4">
        <span>📋 官方核验 · 14 品牌技术参数档案库</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        2026年 14 大机场品牌技术参数与节点档案
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        收录各品牌官方核验的技术架构，包括节点地区覆盖、协议支持、设备并发数及起步资费明细。
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {airports.map((airport) => {
        const cleanName = airport.name.replace(/（[^）]*）/g, '').split(' ')[0];
        return (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md">
                官方档案
              </span>
              <span class="text-xs text-slate-400">核验日期: {airport.lastVerified}</span>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-2">
              <a href={`/airport/${airport.slug}/`} class="hover:text-blue-600">
                {airport.name}
              </a>
            </h2>
            <p class="text-xs text-slate-500 mb-4 line-clamp-2">
              {airport.description}
            </p>

            <div class="space-y-1.5 text-xs text-slate-600 mb-4">
              <div><strong class="text-slate-800">支持协议:</strong> {airport.protocols.join(', ')}</div>
              <div><strong class="text-slate-800">覆盖节点:</strong> {airport.regions.slice(0, 4).join(', ')}</div>
              <div><strong class="text-slate-800">起步价格:</strong> ¥{airport.startingPrice}/{airport.plans[0].period}</div>
              <div><strong class="text-slate-800">可用流量:</strong> {airport.plans[0].trafficGb} GB</div>
            </div>

            <div class="flex items-center gap-2 pt-3 border-t border-slate-100">
              <a
                href={`/airport/${airport.slug}/`}
                class="flex-1 text-center py-2 px-3 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
              >
                技术档案
              </a>
              <a
                href={`/review/${airport.slug}/`}
                class="flex-1 text-center py-2 px-3 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm"
              >
                独立评测 &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
