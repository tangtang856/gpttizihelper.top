---
import { airports } from '../data/airports';
---

<section class="py-12" id="compare-matrix">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-800 mb-2">
        <span>📊 14 品牌一站式速查矩阵</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        2026年 14 大主流机场参数与资费全景对比
      </h2>
      <p class="text-slate-500 text-sm mt-2">
        不再需要跳来跳去翻阅长篇大论。支持按“纯专线”、“平价白菜”、“AI原生IP”一键筛选，算清每一分钱的真实成本
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap justify-center gap-2 mt-6" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="matrix-tab active px-3.5 py-1.5 rounded-full text-xs font-bold bg-blue-600 text-white transition-all shadow-sm"
        >
          全部 14 家
        </button>
        <button
          type="button"
          data-filter="iplc"
          class="matrix-tab px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all"
        >
          🚀 纯专线·晚高峰抗封
        </button>
        <button
          type="button"
          data-filter="budget"
          class="matrix-tab px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all"
        >
          💰 白菜平价·超高性价比
        </button>
        <button
          type="button"
          data-filter="ai"
          class="matrix-tab px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all"
        >
          🤖 原生IP·ChatGPT/Netflix
        </button>
      </div>
    </div>

    <!-- Table Container -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 border-b border-slate-200 text-xs text-slate-700 uppercase font-bold">
            <tr>
              <th scope="col" class="py-3.5 px-4 text-center w-16">排名</th>
              <th scope="col" class="py-3.5 px-4">品牌名称与协议</th>
              <th scope="col" class="py-3.5 px-4">起步资费</th>
              <th scope="col" class="py-3.5 px-4">月度流量</th>
              <th scope="col" class="py-3.5 px-4">折算单价</th>
              <th scope="col" class="py-3.5 px-4 hidden md:table-cell">核心专长与线路</th>
              <th scope="col" class="py-3.5 px-4 hidden lg:table-cell">适合人群</th>
              <th scope="col" class="py-3.5 px-4 text-center">直达通道</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="matrix-tbody">
            {airports.map((item, idx) => {
              // Categories tags for filtering
              const isIplc = ['breezenet', 'muguang', 'flashleap', 'yinxingren', 'wuyou'].includes(item.id);
              const isBudget = ['breezenet', 'feimaoyun', 'feiv', 'firefly'].includes(item.id);
              const isAi = ['breezenet', 'lingmao', 'yinxingren', 'wavenet', 'kuajiecloud'].includes(item.id);
              const filterTags = ['all', isIplc ? 'iplc' : '', isBudget ? 'budget' : '', isAi ? 'ai' : ''].filter(Boolean).join(' ');

              return (
                <tr class="hover:bg-blue-50/40 transition-colors matrix-row" data-tags={filterTags}>
                  <td class="py-3.5 px-4 text-center">
                    <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ${
                      idx === 0 ? 'bg-amber-100 text-amber-800 border border-amber-300' :
                      idx === 1 ? 'bg-slate-200 text-slate-800' :
                      idx === 2 ? 'bg-amber-50 text-amber-700' :
                      'bg-slate-100 text-slate-500'
                    }`}>
                      {idx + 1}
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <a href={`/review/${item.slug}/`} class="font-bold text-slate-900 hover:text-blue-600 block transition-colors">
                      {item.name}
                    </a>
                    <div class="flex items-center gap-1.5 mt-0.5">
                      {item.protocols.map((p) => (
                        <span class="text-[10px] px-1.5 py-0.2 bg-slate-100 text-slate-600 rounded font-mono">
                          {p}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="font-extrabold text-blue-600 text-base">¥{item.startingPrice}</span>
                    <span class="text-[11px] text-slate-400">/{item.plans[0].period}</span>
                  </td>
                  <td class="py-3.5 px-4 font-semibold text-slate-800">
                    {item.plans[0].trafficGb} GB
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-bold bg-blue-50 text-blue-700">
                      {item.plans[0].unitPricePerGb.toFixed(3)} 元/GB
                    </span>
                  </td>
                  <td class="py-3.5 px-4 hidden md:table-cell text-xs text-slate-600 max-w-[200px] truncate">
                    {item.plans[0].note.split('，')[0]}
                  </td>
                  <td class="py-3.5 px-4 hidden lg:table-cell text-xs text-slate-500">
                    {item.suitableFor[0]}
                  </td>
                  <td class="py-3.5 px-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <a
                        href={`/review/${item.slug}/`}
                        class="hidden sm:inline-block px-2.5 py-1 text-xs font-medium text-slate-600 hover:text-blue-600 bg-slate-100 hover:bg-slate-200 rounded transition-colors"
                      >
                        实测
                      </a>
                      <a
                        href={item.affiliateUrl}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                        class="px-3 py-1 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded transition-colors shadow-sm"
                      >
                        官网 &rarr;
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.matrix-tab');
  const rows = document.querySelectorAll<HTMLTableRowElement>('.matrix-row');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active', 'bg-blue-600', 'text-white');
        t.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      tab.classList.add('active', 'bg-blue-600', 'text-white');
      tab.classList.remove('bg-white', 'text-slate-600', 'border');

      const filter = tab.getAttribute('data-filter') || 'all';

      rows.forEach((row) => {
        const tags = (row.getAttribute('data-tags') || '').split(' ');
        if (filter === 'all' || tags.includes(filter)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });
</script>
