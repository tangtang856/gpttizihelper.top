---
const navLinks = [
  { name: '首页', href: '/' },
  { name: '品牌专区', href: '/review/' },
  { name: '机场推荐', href: '/recommend/budget/' },
  { name: '天梯排行', href: '/ranking/overall/' },
  { name: '在线PK对比', href: '/compare/' },
  { name: '使用教程', href: '/guides/' },
  { name: '技术博客', href: '/blog/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="text-2xl p-1.5 bg-blue-50 text-blue-600 rounded-xl border border-blue-100 group-hover:scale-105 transition-transform">🤖</span>
        <div class="flex flex-col">
          <span class="font-extrabold text-lg tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">
            GPT梯子机场帮手
          </span>
          <span class="text-[10px] font-medium text-slate-500 uppercase tracking-widest">
            gpttizihelper.top
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-all ${
                isActive
                  ? 'bg-blue-50 text-blue-600 shadow-sm'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-2.5">
        <!-- 联络我们 按钮 (对应红框位置) -->
        <button
          type="button"
          id="btn-open-contact-modal"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-bold text-slate-700 hover:text-blue-600 bg-slate-100 hover:bg-blue-50 border border-slate-200 hover:border-blue-300 rounded-lg transition-all active:scale-95 cursor-pointer"
        >
          <span>💬 联络我们</span>
        </button>

        <a
          href="/compare/"
          class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 active:bg-blue-800 rounded-lg shadow-sm shadow-blue-500/20 transition-all hover:scale-[1.02]"
        >
          <span>⚖️ 14家在线PK</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-blue-50"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-2 space-y-2">
      <button
        type="button"
        id="btn-open-contact-modal-mobile"
        class="block w-full text-center px-4 py-2.5 text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg cursor-pointer"
      >
        💬 联络我们 (Gmail / Telegram)
      </button>
      <a
        href="/compare/"
        class="block w-full text-center px-4 py-2.5 text-sm font-bold text-white bg-blue-600 rounded-lg"
      >
        ⚖️ 14家机场在线PK对比
      </a>
    </div>
  </div>

  <!-- 联络我们 专业弹窗 Modal -->
  <div
    id="contact-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden"
    aria-hidden="true"
  >
    <div
      class="bg-white rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative transform transition-all"
      role="dialog"
      aria-modal="true"
    >
      <!-- Close Button -->
      <button
        type="button"
        id="btn-close-contact-modal"
        class="absolute top-4 right-4 p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-full transition-colors cursor-pointer"
        aria-label="关闭弹窗"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Modal Header -->
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl p-2.5 bg-blue-50 text-blue-600 rounded-2xl border border-blue-100 shadow-sm">
          💬
        </span>
        <div>
          <h3 class="text-xl font-black text-slate-900 tracking-tight">
            联络我们 · 商务合作
          </h3>
          <p class="text-xs text-slate-500 mt-0.5">
            GPT梯子机场帮手 官方直联通道 · 24小时内极速响应
          </p>
        </div>
      </div>

      <!-- Contact Channels Cards -->
      <div class="space-y-4">
        <!-- 1. Gmail Channel -->
        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/70 hover:border-blue-300 transition-colors">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
              <span class="text-base">📧</span>
              <span>官方联系邮箱 (Gmail)</span>
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
              商务 / 送测 / 勘误
            </span>
          </div>

          <div class="p-2.5 bg-white rounded-lg border border-slate-200 font-mono text-sm text-slate-900 font-bold flex items-center justify-between mb-2 select-all">
            <span id="text-gmail">xintangtang888@gmail.com</span>
            <button
              type="button"
              data-copy-target="xintangtang888@gmail.com"
              class="btn-copy-contact px-2.5 py-1 text-xs font-semibold bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-blue-600 rounded transition-colors cursor-pointer"
            >
              复制
            </button>
          </div>

          <p class="text-[11px] text-slate-500 leading-relaxed mb-3">
            承接海内外机场节点送测入驻、广告合作、专属折扣码兑换申请与技术勘误，工作日 24 小时内必复。
          </p>

          <a
            href="mailto:xintangtang888@gmail.com"
            class="block w-full text-center py-2.5 px-3 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-colors"
          >
            ✉️ 发送邮件直达 (Gmail) &rarr;
          </a>
        </div>

        <!-- 2. Telegram Channel -->
        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/70 hover:border-blue-300 transition-colors">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
              <span class="text-base">✈️</span>
              <span>Telegram 官方直连 (TLG)</span>
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-blue-100 text-blue-800">
              实时在线极速沟通
            </span>
          </div>

          <div class="p-2.5 bg-white rounded-lg border border-slate-200 font-mono text-sm text-slate-900 font-bold flex items-center justify-between mb-2 select-all">
            <span id="text-tlg">@xintangtang</span>
            <button
              type="button"
              data-copy-target="@xintangtang"
              class="btn-copy-contact px-2.5 py-1 text-xs font-semibold bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-blue-600 rounded transition-colors cursor-pointer"
            >
              复制
            </button>
          </div>

          <p class="text-[11px] text-slate-500 leading-relaxed mb-3">
            站长与专属客服在线直连，适合紧急技术咨询、节点加急测试及深度出海网络技术交流。
          </p>

          <a
            href="https://t.me/xintangtang"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center py-2.5 px-3 text-xs font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-xl shadow-sm transition-colors"
          >
            ✈️ 打开 Telegram 直连对话 (@xintangtang) &rarr;
          </a>
        </div>
      </div>

      <!-- Toast Tip -->
      <div id="contact-copy-toast" class="hidden mt-3 p-2 rounded-lg bg-emerald-50 text-emerald-700 text-xs font-bold text-center border border-emerald-200">
        ✓ 已复制到剪贴板！
      </div>

      <!-- Modal Footer -->
      <div class="mt-5 pt-4 border-t border-slate-200 flex items-center justify-between text-xs text-slate-400">
        <span>GPT梯子机场帮手 · 官方认证通道</span>
        <button
          type="button"
          id="btn-dismiss-modal"
          class="text-slate-600 hover:text-slate-900 font-semibold cursor-pointer"
        >
          关闭
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Contact Modal
  const modal = document.getElementById('contact-modal');
  const openBtn = document.getElementById('btn-open-contact-modal');
  const openMobileBtn = document.getElementById('btn-open-contact-modal-mobile');
  const closeBtn = document.getElementById('btn-close-contact-modal');
  const dismissBtn = document.getElementById('btn-dismiss-modal');
  const toast = document.getElementById('contact-copy-toast');

  function openContact() {
    modal?.classList.remove('hidden');
  }

  function closeContact() {
    modal?.classList.add('hidden');
    if (toast) toast.classList.add('hidden');
  }

  openBtn?.addEventListener('click', openContact);
  openMobileBtn?.addEventListener('click', openContact);
  closeBtn?.addEventListener('click', closeContact);
  dismissBtn?.addEventListener('click', closeContact);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeContact();
    }
  });

  // Copy buttons
  document.querySelectorAll<HTMLButtonElement>('.btn-copy-contact').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy-target') || '';
      if (text && navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => {
          if (toast) {
            toast.textContent = `✓ 已成功复制：${text}`;
            toast.classList.remove('hidden');
            setTimeout(() => {
              toast.classList.add('hidden');
            }, 2500);
          }
        });
      }
    });
  });
</script>
